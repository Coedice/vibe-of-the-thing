{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "d3": "readonly",
    "window": "readonly",
    "document": "readonly",
    "navigator": "readonly",
    "alert": "readonly",
    "console": "readonly",
    "process": "readonly",
    "module": "readonly",
    "require": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly"
  },
  "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "double"]
  }
}